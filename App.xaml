<Application x:Class="ArtFinder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Цветовая схема -->
        <SolidColorBrush x:Key="BgDark"       Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#252535"/>
        <SolidColorBrush x:Key="BgCard"       Color="#2D2D42"/>
        <SolidColorBrush x:Key="AccentBlue"   Color="#5B9BD5"/>
        <SolidColorBrush x:Key="AccentGreen"  Color="#4CAF7D"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#F0C040"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#E8E8F0"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#888899"/>
        <SolidColorBrush x:Key="BorderColor"  Color="#3D3D55"/>

        <!-- Базовый стиль кнопки -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Foreground"             Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background"             Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="10,5"/>
            <Setter Property="Height"                 Value="32"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="FontSize"               Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Акцентные кнопки -->
        <Style x:Key="BlueBtn"   BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="GreenBtn"  BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="YellowBtn" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="#B8860B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Стиль TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="CaretBrush"   Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Padding"    Value="0,0,0,2"/>
        </Style>

    </Application.Resources>
</Application>
