<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <Product>ArtFinder</Product>
    <!-- Манифест: per-monitor DPI и совместимость с Windows 10/11 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resource, а не Content: иконка окна встраивается в сборку и находится
         и в однофайловой публикации (Content-файл там не разрешался → падение). -->
    <Resource Include="icon.ico" />
    <!-- Список запрещённых тегов Civitai для TagFilter -->
    <EmbeddedResource Include="Resources\BlockedTags.txt" LogicalName="ArtFinder.Resources.BlockedTags.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

</Project>
