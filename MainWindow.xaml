<Window x:Class="ArtFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ArtFinder"
        Height="900" Width="1400" MinWidth="940" MinHeight="600"
        Icon="icon.ico"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ToolTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ToolHint" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground"   Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="FieldText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="{StaticResource TextMuted}"/>
        </Style>
    </Window.Resources>

    <!-- Имена окна, кнопок «◀» / «Сохранить оригинал» и TxtStatus используются
         Art Saver (UI Automation) — их тексты и x:Name менять нельзя. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft"  Width="2.2*" MinWidth="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="ColRight" Width="1*"   MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════ ЛЕВАЯ ПАНЕЛЬ ══════════════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель инструментов -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Выбор сайта -->
                        <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="6"
                                Padding="4,2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnE621"   Content="e621.net"   Style="{StaticResource BlueBtn}"
                                        MinWidth="90" Margin="0,0,4,0" Click="BtnE621_Click"/>
                                <Button x:Name="BtnRule34" Content="rule34.xxx" Style="{StaticResource BaseBtn}"
                                        MinWidth="90" Click="BtnRule34_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Навигация -->
                        <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="6"
                                Padding="4,2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBack" Content="◀" Style="{StaticResource BaseBtn}" MinWidth="36"
                                        Margin="0,0,2,0" Click="BtnBack_Click" ToolTip="Назад"
                                        IsEnabled="False" AutomationProperties.AutomationId="BtnBack"/>
                                <Button x:Name="BtnForward" Content="▶" Style="{StaticResource BaseBtn}" MinWidth="36"
                                        Margin="0,0,2,0" Click="BtnForward_Click" ToolTip="Вперёд"
                                        IsEnabled="False"/>
                                <Button Content="↺" Style="{StaticResource BaseBtn}" MinWidth="36"
                                        Click="BtnRefresh_Click" ToolTip="Обновить (F5)"/>
                            </StackPanel>
                        </Border>

                        <!-- Настройки API -->
                        <Button Grid.Column="2" Content="⚙ API" Style="{StaticResource BaseBtn}"
                                MinWidth="70" Click="BtnApiSettings_Click" ToolTip="Настройки API-ключей"/>

                        <!-- Адрес страницы / поиск по тегам -->
                        <TextBox x:Name="TxtAddress" Grid.Column="3" Margin="10,0,0,0" MinWidth="80"
                                 VerticalAlignment="Center"
                                 Tag="Адрес страницы или теги для поиска"
                                 ToolTip="Enter — открыть адрес или найти теги на текущем сайте (Ctrl+L)"
                                 KeyDown="TxtAddress_KeyDown"
                                 GotKeyboardFocus="TxtAddress_GotKeyboardFocus"/>
                    </Grid>
                </Border>

                <!-- WebView2 -->
                <wv2:WebView2 x:Name="WebView" Grid.Row="1"/>
            </Grid>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderColor}" Cursor="SizeWE"
                          Focusable="False"/>

            <!-- ══════════════ ПРАВАЯ ПАНЕЛЬ ══════════════ -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}">
            <Grid Margin="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Вкладки: кроп и бывшие Python-утилиты — всё в одном окне -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="6" Padding="3" Margin="0,0,0,10">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="TabCrop"     Content="Кроп"        Style="{StaticResource TabButton}"
                                     GroupName="RightTabs" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSaver"    Content="Скачать всё" Style="{StaticResource TabButton}"
                                     GroupName="RightTabs" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabMirror"   Content="Зеркало"     Style="{StaticResource TabButton}"
                                     GroupName="RightTabs" Checked="Tab_Checked"/>
                    </UniformGrid>
                </Border>

                <Grid Grid.Row="1">
                <!-- ══════ Вкладка «Кроп» ══════ -->
                <Grid x:Name="RightPanel" SizeChanged="RightPanel_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Поле кропа занимает всё свободное место -->
                        <RowDefinition Height="*" MinHeight="140"/>
                        <!-- Управление: прокручивается, только если окно слишком низкое
                             (MaxHeight выставляется в RightPanel_SizeChanged) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок + размер арта -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Просмотр и кроп" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtImageSize" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </Grid>

                    <!-- ── Поле кропа ── -->
                    <Border Grid.Row="1" Background="{StaticResource BgCanvas}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" ClipToBounds="True" Margin="0,0,0,8">
                        <!-- WorkArea — контейнер, по которому считается GetImageRect() -->
                        <Grid x:Name="WorkArea" Background="Transparent" Focusable="True"
                              FocusVisualStyle="{x:Null}"
                              SizeChanged="WorkArea_SizeChanged"
                              PreviewKeyDown="WorkArea_PreviewKeyDown"
                              MouseWheel="WorkArea_MouseWheel"
                              ToolTipService.InitialShowDelay="1500">

                            <TextBlock x:Name="TxtCropHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                                       FontSize="12" Foreground="{StaticResource TextDim}"
                                       Text="Откройте пост на сайте слева — арт появится здесь"/>

                            <Image x:Name="ArtImage" Stretch="Uniform" StretchDirection="Both"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Canvas x:Name="CropCanvas" Background="Transparent"
                                    MouseLeftButtonDown="CropCanvas_MouseDown"
                                    MouseMove="CropCanvas_MouseMove"
                                    MouseLeftButtonUp="CropCanvas_MouseUp"
                                    LostMouseCapture="CropCanvas_LostMouseCapture">

                                <!-- Затемнение вне рамки -->
                                <Rectangle x:Name="OverlayTop"    Fill="#B0000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="OverlayBottom" Fill="#B0000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="OverlayLeft"   Fill="#B0000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="OverlayRight"  Fill="#B0000000" IsHitTestVisible="False"/>

                                <!-- Рамка кропа -->
                                <Rectangle x:Name="CropRect"
                                           Stroke="{StaticResource AccentYellow}" StrokeThickness="2"
                                           Fill="Transparent" Cursor="SizeAll"
                                           Visibility="Collapsed"/>

                                <!-- Ручка ресайза -->
                                <Rectangle x:Name="ResizeHandle"
                                           Width="14" Height="14"
                                           Fill="{StaticResource AccentYellow}" Cursor="SizeNWSE"
                                           Stroke="#000000" StrokeThickness="1"
                                           RadiusX="2" RadiusY="2"
                                           Visibility="Collapsed"
                                           MouseLeftButtonDown="ResizeHandle_MouseDown"
                                           MouseMove="ResizeHandle_MouseMove"
                                           MouseLeftButtonUp="ResizeHandle_MouseUp"
                                           LostMouseCapture="ResizeHandle_LostMouseCapture"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ControlsScroll" Grid.Row="2" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <!-- Размер рамки: можно ввести точное значение -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Рамка:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="TxtCropW" Grid.Column="1" Tag="ширина" IsEnabled="False"
                                 TextAlignment="Center" MaxLength="5"
                                 ToolTip="Ширина рамки в пикселях арта (Enter — применить)"
                                 PreviewTextInput="CropSizeBox_PreviewTextInput"
                                 KeyDown="CropSizeBox_KeyDown" LostKeyboardFocus="CropSizeBox_LostKeyboardFocus"/>
                        <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Margin="6,0"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="TxtCropH" Grid.Column="3" Tag="высота" IsEnabled="False"
                                 TextAlignment="Center" MaxLength="5"
                                 ToolTip="Высота рамки в пикселях арта (Enter — применить)"
                                 PreviewTextInput="CropSizeBox_PreviewTextInput"
                                 KeyDown="CropSizeBox_KeyDown" LostKeyboardFocus="CropSizeBox_LostKeyboardFocus"/>
                        <TextBlock Grid.Column="4" Text="px" VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </Grid>

                    <!-- Фиксировать размер -->
                    <Button x:Name="BtnLockSize" Content="Фиксировать размер рамки"
                            Style="{StaticResource BaseBtn}" HorizontalAlignment="Stretch"
                            Height="34" Margin="0,0,0,8" Click="BtnLockSize_Click"/>

                    <!-- Кнопки сохранения -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSaveCrop" Grid.Column="0" Content="💾  Сохранить кроп"
                                Style="{StaticResource BlueBtn}" Height="40" IsEnabled="False"
                                ToolTip="Ctrl+S" Click="BtnSaveCrop_Click"/>
                        <Button x:Name="BtnSaveOriginal" Grid.Column="2" Content="🖼  Сохранить оригинал"
                                Style="{StaticResource GreenBtn}" Height="40" IsEnabled="False"
                                ToolTip="Ctrl+Shift+S" Click="BtnSaveOriginal_Click"
                                AutomationProperties.AutomationId="BtnSaveOriginal"/>
                    </Grid>

                    <!-- Главный тег -->
                    <StackPanel Margin="0,0,0,10">
                        <Label Content="ГЛАВНЫЙ ТЕГ" Target="{Binding ElementName=TxtMainTag}"/>
                        <TextBox x:Name="TxtMainTag"
                                 Tag="триггер-слово, можно несколько через запятую"
                                 ToolTip="Добавляется первым в каждый файл тегов"
                                 TextChanged="TxtMainTag_TextChanged"/>
                    </StackPanel>

                    <!-- Путь сохранения -->
                    <StackPanel Margin="0,0,0,10">
                        <Button Content="📁  Выбрать папку сохранения"
                                Style="{StaticResource BaseBtn}" HorizontalAlignment="Stretch"
                                Height="34" Margin="0,0,0,4" Click="BtnChoosePath_Click"/>
                        <TextBlock x:Name="TxtSavePath" Text="(папка не выбрана)"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="2,0,0,0"
                                   MouseLeftButtonUp="TxtSavePath_MouseLeftButtonUp"/>
                    </StackPanel>

                    <!-- Теги: ровно то, что будет записано в .txt -->
                    <Expander x:Name="TagsExpander" Header="Теги текущего арта">
                        <Border Background="{StaticResource BgCard}" CornerRadius="4"
                                Padding="8,6" Margin="0,4,0,0">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="TxtTagsPreview" Foreground="{StaticResource TextPrimary}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Text="(теги не загружены)"/>
                                    <TextBlock x:Name="TxtTagsRemoved" Foreground="{StaticResource StatusError}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════ Вкладка «Скачать всё» (бывший Art Saver) ══════ -->
                <Grid x:Name="PanelSaver" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Скачать всё из поиска" Style="{StaticResource ToolTitle}"/>
                        <TextBlock Style="{StaticResource ToolHint}"
                                   Text="Сохраняет оригиналы всех артов из поиска, открытого слева (e621 или rule34), в папку сохранения — с тегами, как кнопка «Сохранить оригинал». Видео пропускаются. Окно при этом остаётся свободным."/>
                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="8,6" Margin="0,10,0,8">
                            <TextBlock x:Name="TxtSaverSearch" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="Откройте страницу поиска на e621 или rule34"/>
                        </Border>
                        <CheckBox x:Name="ChkSaverFromCurrent" Content="Начать с текущей страницы поиска" IsChecked="True"/>
                        <CheckBox x:Name="ChkSaverSkipExisting" Content="Пропускать уже сохранённые" IsChecked="True"
                                  ToolTip="Можно остановить и потом продолжить с того же места"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Не больше" Style="{StaticResource FieldText}" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSaverLimit" Width="80" Tag="все" MaxLength="6" TextAlignment="Center"
                                     PreviewTextInput="DigitsOnly_PreviewTextInput"/>
                            <TextBlock Text="артов" Style="{StaticResource FieldText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,12,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnSaverStart" Grid.Column="0" Content="▶  Старт" Style="{StaticResource BlueBtn}"
                                    Height="36" Click="BtnSaverStart_Click"/>
                            <Button x:Name="BtnSaverStop" Grid.Column="2" Content="■  Стоп" Style="{StaticResource BaseBtn}"
                                    Height="36" IsEnabled="False" Click="BtnJobStop_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtSaverStats" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   Text="Сохранено: 0  ·  Пропущено: 0  ·  Ошибок: 0"/>
                    </StackPanel>
                    <TextBox x:Name="LogSaver" Grid.Row="2" Style="{StaticResource LogBox}"/>
                </Grid>
                <!-- ══════ Вкладка «Зеркало» (бывший Dataset Mirror) ══════ -->
                <Grid x:Name="PanelMirror" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Зеркало датасета" Style="{StaticResource ToolTitle}"/>
                        <TextBlock Style="{StaticResource ToolHint}"
                                   Text="Добавляет в датасет отражённые по горизонтали копии картинок вместе с копиями их описаний. Всё сохраняется в ту же папку; повторный запуск пропускает уже готовое."/>
                        <Label Content="ПАПКА ДАТАСЕТА — ПАПКА СОХРАНЕНИЯ С ВКЛАДКИ «КРОП»" Margin="0,10,0,0" Target="{Binding ElementName=TxtMirrorFolder}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtMirrorFolder" IsReadOnly="True" Tag="(папка не выбрана)"
                                     ToolTip="Та же папка, куда сохраняются посты. «Обзор…» меняет её для обеих вкладок"/>
                            <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource BaseBtn}" Margin="6,0,0,0"
                                    Height="30" Click="BtnChoosePath_Click"/>
                        </Grid>
                        <Label Content="СУФФИКС ИМЕНИ" Margin="0,8,0,0" Target="{Binding ElementName=TxtMirrorSuffix}"/>
                        <TextBox x:Name="TxtMirrorSuffix" Width="140" HorizontalAlignment="Left" Text="_flip" Tag="_flip"/>
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox x:Name="ChkMirrorRecursive" Content="Включая подпапки"/>
                            <CheckBox x:Name="ChkMirrorSwap" Content="Менять left ↔ right в тегах копий"
                                      ToolTip="facing_left → facing_right и т.п.: у отражённой картинки направление меняется"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnMirrorRun" Grid.Row="1" Margin="0,12,0,8" Content="Отзеркалить"
                            Style="{StaticResource BlueBtn}" Height="36" Click="BtnMirrorRun_Click"/>
                    <TextBox x:Name="LogMirror" Grid.Row="2" Style="{StaticResource LogBox}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
        </Grid>

        <!-- ══════════════ СТРОКА СОСТОЯНИЯ ══════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BgDark}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text=""
                           Foreground="{StaticResource StatusOk}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Margin="16,0,0,0" MinHeight="22">
                    <TextBlock x:Name="TxtHotkeys" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextDim}"
                               Text="Ctrl+S — кроп  ·  Ctrl+Shift+S — оригинал  ·  Ctrl+L — адрес"/>
                    <!-- Фоновая задача: название, прогресс, остановка -->
                    <StackPanel x:Name="JobPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock x:Name="TxtJob" VerticalAlignment="Center" FontSize="11" MaxWidth="420"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimary}"/>
                        <ProgressBar x:Name="JobProgress" Width="160" Margin="10,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnJobStop" Content="Стоп" Style="{StaticResource BaseBtn}" Height="22"
                                Padding="10,0" FontSize="11" Click="BtnJobStop_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
