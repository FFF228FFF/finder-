<Window x:Class="ArtFinder.ApiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки API" Width="440" SizeToContent="Height"
        Background="{StaticResource BgDark}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки авторизации" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"/>

        <!-- e621 -->
        <StackPanel Grid.Row="2">
            <Label Content="e621.net — Логин"/>
            <TextBox x:Name="TxtE621Login" Height="30"/>
        </StackPanel>
        <StackPanel Grid.Row="4">
            <Label Content="e621.net — API Key"/>
            <PasswordBox x:Name="PwdE621Key" Height="30"/>
        </StackPanel>

        <!-- rule34 данные берутся со страницы поста — ключи не нужны -->
        <TextBlock Grid.Row="6" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource TextMuted}"
                   Text="rule34.xxx: авторизация не требуется — арт и теги читаются прямо со страницы поста."/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource BaseBtn}" Width="80"
                    Margin="0,0,8,0" Click="BtnCancel_Click" IsCancel="True"/>
            <Button Content="Сохранить" Style="{StaticResource BlueBtn}" Width="100"
                    Click="BtnSave_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
