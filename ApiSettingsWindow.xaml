<Window x:Class="ArtFinder.ApiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки API" Width="440" SizeToContent="Height"
        Background="{StaticResource BgPanel}"
        Foreground="{StaticResource TextPrimary}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=TxtE621Login}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки авторизации" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"/>

        <!-- e621 -->
        <StackPanel Grid.Row="2">
            <Label Content="e621.net — Логин" Target="{Binding ElementName=TxtE621Login}"/>
            <TextBox x:Name="TxtE621Login"/>
        </StackPanel>
        <StackPanel Grid.Row="4">
            <Label Content="e621.net — API Key" Target="{Binding ElementName=PwdE621Key}"/>
            <PasswordBox x:Name="PwdE621Key"/>
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextMuted}"
                       Text="Ключ создаётся на e621.net: Account → Manage API Access."/>
        </StackPanel>

        <!-- rule34 данные берутся со страницы поста — ключи не нужны -->
        <TextBlock Grid.Row="6" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource TextMuted}"
                   Text="rule34.xxx: авторизация не требуется — арт и теги читаются прямо со страницы поста."/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource BaseBtn}" MinWidth="80"
                    Margin="0,0,8,0" Click="BtnCancel_Click" IsCancel="True"/>
            <Button Content="Сохранить" Style="{StaticResource BlueBtn}" MinWidth="100"
                    Click="BtnSave_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
